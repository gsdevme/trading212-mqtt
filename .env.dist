# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Loaded automatically for local `serve` / `mock` runs via godotenv.

# --- Target ---
# mock: run against the local `mock` server (default here; credentials below are
#       ignored and dummy values are used).
# demo: the Trading 212 paper-trading environment.
# live: the real account.
MODE=mock
# Only needed if the mock runs on a non-default address (see `mock --addr`).
# MOCK_URL=http://localhost:8090

# --- Trading 212 credentials (required when MODE=live or demo) ---
T212_API_KEY=
# Leave empty to use the legacy bare-key Authorization scheme.
T212_API_SECRET=

# --- Positions ---
# Empty  = account entities only, no position devices.
# List   = track exactly these tickers, e.g. AAPL_US_EQ,VUSA_EQ
# *      = track every currently-held position.
#
# Don't know your ticker IDs? Leave this empty and start the service: every poll
# logs `held=AAPL_US_EQ,VUSA_EQ,...` and the status page on / lists the same
# holdings with a TICKERS= line to copy. Paste it back in here and restart.
TICKERS=

# --- Polling ---
POLL_INTERVAL=5m
POLL_MAX_RETRIES=3
READY_FAILURE_THRESHOLD=3

# --- MQTT ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=trading212-mqtt
TOPIC_PREFIX=trading212
DISCOVERY_PREFIX=homeassistant

# --- HTTP & logging ---
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
